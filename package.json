    "db:seed-admin": "node scripts/create-admin.mjs",
    "db:smoke": "node scripts/e2e-smoke.mjs",
    "db:penalty": "node scripts/test-penalty.mjs",
    "db:competition": "node scripts/test-competition.mjs",
