# -----------------------------------------------------------------------------
# Variables de entorno de ejemplo.
#
# Copia este archivo a `.env` y rellena los valores. NO incluyas secretos reales
# en el repositorio. Las variables sin el prefijo `NEXT_PUBLIC_` solo están
# disponibles en el servidor (nunca se envían al navegador).
# -----------------------------------------------------------------------------

# Conexión a PostgreSQL (solo servidor).
# Desarrollo local con Docker (npm run db:up):
DATABASE_URL=postgresql://aula_app:change_me_local@localhost:5432/aula_competicion
# Producción (AWS RDS): usa SIEMPRE TLS. Ejemplo:
# DATABASE_URL=postgresql://USUARIO:CONTRASENA@TU-RDS.REGION.rds.amazonaws.com:5432/aula_competicion?sslmode=require

# Contraseña del contenedor PostgreSQL local (la usa docker-compose.yml).
POSTGRES_PASSWORD=change_me_local

# Nombre visible de la competición (valor público, se muestra en la interfaz).
NEXT_PUBLIC_COMPETITION_NAME=Competición por equipos

# Clave AES-256-GCM (32 bytes) para cifrar los códigos de acceso de grupo.
# Solo servidor. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ACCESS_CODE_ENC_KEY=

# Administrador inicial (lo usa npm run db:seed-admin).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_admin
ADMIN_NAME=Docente

# Marca `Secure` de las cookies de sesión. Déjalo vacío para que se decida
# automáticamente según el esquema de la petición (https -> Secure; http -> no).
# Fuerza `true` para exigir HTTPS o `false` para permitir HTTP sin TLS (por
# ejemplo, un despliegue de pruebas por IP pública sin certificado).
COOKIE_SECURE=
